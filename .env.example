# Local development only. Replace every value before any public deployment.
POSTGRES_DB=throughmylens
POSTGRES_USER=throughmylens
POSTGRES_PASSWORD=local-postgres-password-change-before-deploy

MINIO_ROOT_USER=throughmylens
MINIO_ROOT_PASSWORD=local-minio-password-change-before-deploy

ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://throughmylens:local-postgres-password-change-before-deploy@localhost:5432/throughmylens
WEB_ORIGINS=http://localhost:3000
AUTH_SECRET_KEY=local-development-only-replace-before-deploy-8f43d0e6f9c54125a4df
AUTH_SESSION_COOKIE_NAME=tml_session
AUTH_CSRF_COOKIE_NAME=tml_csrf
AUTH_SESSION_TTL_HOURS=12

S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=throughmylens
S3_SECRET_KEY=local-minio-password-change-before-deploy
S3_PRIVATE_BUCKET=tml-private
S3_PUBLIC_BUCKET=tml-public
S3_PUBLIC_BASE_URL=http://localhost:9000/tml-public

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Native Windows: ExifTool.exe must be on PATH, or use its absolute path here.
EXIFTOOL_PATH=exiftool
PHOTO_MAX_UPLOAD_MB=30
PHOTO_MAX_MEGAPIXELS=60
# Native API runs one durable queue consumer; Docker uses a separate worker.
IMAGE_WORKER_ENABLED=true
S3_BROWSER_ENDPOINT_URL=http://localhost:9000
